# Supabase — get these from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key — NEVER expose to client (no NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Site URL — used to generate invite links
NEXT_PUBLIC_SITE_URL=http://localhost:3030

# Mock data mode — bypasses Supabase entirely (in-memory data + fake admin login).
# Set to false once a real Supabase project is connected above.
NEXT_PUBLIC_MOCK_MODE=false
