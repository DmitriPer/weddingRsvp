# Copy to .env.local and fill in.

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. NEVER prefix this NEXT_PUBLIC_ — that prefix means "ship this to
# the browser", and this key bypasses RLS entirely (PRD §7.3).
SUPABASE_SECRET_KEY=

# --- Site ------------------------------------------------------------------
# Builds invite links and the absolute OpenGraph image URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3030

# --- One-off: scripts/create-admin.ts --------------------------------------
# Only needed when creating the single admin account. Do not commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
