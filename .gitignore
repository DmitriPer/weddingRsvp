# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
env.local
env
# ^ dotless variants: easy to create by accident, must never be committed

# vercel
.vercel

# editors
.idea/
.vscode/

# typescript
*.tsbuildinfo
next-env.d.ts

# agent worktrees — a worktree inside the repo gets committed as a stray
# gitlink (mode 160000) with no .gitmodules, which breaks a fresh clone and
# puts a whole stale .next build in front of eslint. One was tracked this way
# until 2026-09-09 and made `npm run lint` report ~11,000 phantom problems.
.claude/worktrees/
